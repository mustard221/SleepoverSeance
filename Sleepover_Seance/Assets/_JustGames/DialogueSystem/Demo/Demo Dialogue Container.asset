  NodeData:
  - NodeID: ea26cabc-2d01-4fcf-b1cb-2b1ff43ce84b
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "Hey there, traveler. You look like you\u2019ve been through a
      lot."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: -150, y: -20}
    Choices:
    - ChoiceText: "I\u2019m fine. Just passing through."
      TargetNodeID: 52443f95-d072-4bd6-bfaf-56c412f7115b
    - ChoiceText: Do I look that bad?
      TargetNodeID: 17196c4b-38a3-4bc7-99bd-8840cad2b4d5
    - ChoiceText: Who are you?
      TargetNodeID: d04468fd-f95b-47ce-903d-21526c613713
  - NodeID: 52443f95-d072-4bd6-bfaf-56c412f7115b
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "Fair enough. Roads aren\u2019t safe these days."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 458, y: -317}
    Choices:
    - ChoiceText: "Why aren\u2019t they safe?"
      TargetNodeID: 8b3d7f13-0e76-4fd4-ab7c-f426cbc16235
    - ChoiceText: I can handle myself.
      TargetNodeID: c44ca99e-96cd-456a-888d-fc37d33b93f3
  - NodeID: 17196c4b-38a3-4bc7-99bd-8840cad2b4d5
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "Well\u2026 you look like someone who lost a fight with a tornado."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 438, y: -133}
    Choices:
    - ChoiceText: Rude.
      TargetNodeID: 545f0abe-946e-408f-a6b3-69fcdf9b5f3f
    - ChoiceText: You should see the tornado.
      TargetNodeID: d14c9150-0563-4a45-bc15-d5a863b365bf
  - NodeID: d04468fd-f95b-47ce-903d-21526c613713
    NodeType: 0
    SpeakerName: Corin
    SpeakerIcon: {fileID: 0}
    DialogueText: "Name\u2019s Corin. I keep watch over this valley."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 438, y: 60}
    Choices:
    - ChoiceText: Watch for what?
      TargetNodeID: 8b3d7f13-0e76-4fd4-ab7c-f426cbc16235
    - ChoiceText: Sounds boring.
      TargetNodeID: 545f0abe-946e-408f-a6b3-69fcdf9b5f3f
  - NodeID: 8b3d7f13-0e76-4fd4-ab7c-f426cbc16235
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "Creatures have been moving at night. Something\u2019s stirring
      in the old ruins."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 1107, y: -317}
    Choices:
    - ChoiceText: Should I check it out?
      TargetNodeID: 13e89fb8-6912-4557-9f39-3fa035f8ac34
    - ChoiceText: Not my problem.
      TargetNodeID: c44ca99e-96cd-456a-888d-fc37d33b93f3
  - NodeID: c44ca99e-96cd-456a-888d-fc37d33b93f3
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: Confidence is good. Overconfidence gets people buried.
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 1080, y: -133}
    Choices:
    - ChoiceText: "I\u2019ll take my chances."
      TargetNodeID: 6c804e1c-0324-48b8-8720-90ba6d14fc03
    - ChoiceText: "You\u2019re right. Tell me more."
      TargetNodeID: 8b3d7f13-0e76-4fd4-ab7c-f426cbc16235
  - NodeID: 545f0abe-946e-408f-a6b3-69fcdf9b5f3f
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "If you don\u2019t want help, don\u2019t ask for it."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 1080, y: 44}
    Choices:
    - ChoiceText: "Sorry. Let\u2019s start over."
      TargetNodeID: ea26cabc-2d01-4fcf-b1cb-2b1ff43ce84b
    - ChoiceText: "I didn\u2019t ask for help."
      TargetNodeID: 6c804e1c-0324-48b8-8720-90ba6d14fc03
  - NodeID: d14c9150-0563-4a45-bc15-d5a863b365bf
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "Ha! Now that I\u2019d pay to see."
    EventID: 
    EventParameter: 
    ConditionKey: 
    TargetNodeIfTrue: 
    TargetNodeIfFalse: 
    NodePosition: {x: 1079, y: 219}
    Choices:
    - ChoiceText: Back to business.
