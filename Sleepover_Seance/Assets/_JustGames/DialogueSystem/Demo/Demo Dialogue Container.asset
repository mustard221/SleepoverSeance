  - NodeID: 13e89fb8-6912-4557-9f39-3fa035f8ac34
    NodeType: 0
    SpeakerName: Speaker Name
    SpeakerIcon: {fileID: 0}
    DialogueText: "If you\u2019re serious, I can mark the ruins on your map."
